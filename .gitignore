# ====================================
# 🛡️ 工程防污染与敏感凭据屏蔽规约 (.gitignore)
# ====================================

# macOS 系统临时与元数据文件
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# 项目备份包（防爆盘与防撑爆 Git 仓库）
backups/
*.tar.gz
*.zip

# Swift Package Manager 构建输出与缓存
.build/
Packages/
Package.pins
Package.resolved
*.app/


# Xcode 项目与个人用户配置
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/

# 敏感安全凭据与环境变量
.env
*.key
*.pem
credentials.json
client_secret*.json

# 编辑器配置
.vscode/
.idea/
*.swp
*~

# 独立导出发布专区
DJIToDrive_Clean_Export/
DJIToGoogleDrive_Clean_Export/
*_Clean_Export/
